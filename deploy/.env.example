REDIS_URL=redis://127.0.0.1:6401/0
DATABASE_URL=mysql://evacs:evacs@127.0.0.1:33306/evacs
HEALTH_PORT=18082
H3_RESOLUTION=9
ROUTE_PERSISTENCE_ENABLED=true
# Optional validated RoadGraph JSON. Missing graph reports GRAPH_UNAVAILABLE degraded mode.
GRAPH_PATH=
ROUTE_INTERVAL_MS=2000
INACTIVE_TTL_MS=5000
ALERT_TTL_MS=20000
# info | debug (debug logs every route evaluation)
LOG_LEVEL=info
BPR_ALPHA=0.15
BPR_BETA=4
ROAD_CAPACITY=180
BLOCKED_MULTIPLIER=10
STATE_STREAM=stream:vehicle:state
# Control API Server Outbox stream (EVACS-API-Server EVACS_EMERGENCY_STREAM)
EMERGENCY_STREAM=evacs:stream:emergency-event
# Control API Server cone key read by GET /control/emergencies/{id}/cone
EVACS_CONE_KEY_PATTERN=evacs:emergency:%s:cone
ALERT_STREAM=stream:alert:event
EVACS_ALERT_STREAM=evacs:stream:yield-alert
ALERT_OUTBOX_STREAM=stream:emergency-worker:alert-outbox
DLQ_STREAM=stream:emergency-worker:dlq
VEHICLE_CONSUMER_GROUP=emergency-worker:vehicle-state
EMERGENCY_CONSUMER_GROUP=emergency-worker:emergency
CONSUMER_NAME=emergency-worker-local
INSTANCE_ID=emergency-worker-local
BLOCK_MS=1000
READ_COUNT=100
PENDING_MIN_IDLE_MS=10000
MAX_DELIVERIES=5
DLQ_MAXLEN=10000
ALERT_STREAM_MAXLEN=100000
SHUTDOWN_DRAIN_TIMEOUT_MS=10000
