# Emergency-Worker production environment (src/config/config.ts).
# Copy to deploy/.env. Blank values fall back to defaults; any invalid value stops startup with ConfigError.
# Apply the MySQL migrations (migrations/) before starting.

# ---- Required -------------------------------------------------------------
# URL-encode reserved characters in passwords.
REDIS_URL=redis://:replace-with-url-encoded-password@redis.internal:6379/0
# Required while ROUTE_PERSISTENCE_ENABLED=true.
DATABASE_URL=mysql://evacs:replace-with-url-encoded-password@mysql.internal:3306/evacs
ROUTE_PERSISTENCE_ENABLED=true

# Validated RoadGraph JSON inside the container. Empty -> GRAPH_UNAVAILABLE degraded mode.
# A path to a missing file stops startup, so only set this once the graph is mounted.
GRAPH_PATH=

# ---- Instance identity ----------------------------------------------------
# Must be unique per running instance.
# Defaults: CONSUMER_NAME=HOSTNAME, INSTANCE_ID=<hostname>-<pid>.
CONSUMER_NAME=emergency-worker-1
INSTANCE_ID=emergency-worker-1

# ---- Health / logging -----------------------------------------------------
HEALTH_PORT=8082
# info | debug (debug logs every route evaluation)
LOG_LEVEL=info

# ---- Routing behaviour (defaults shown) -----------------------------------
# 8 or 9; must match Location-Worker.
H3_RESOLUTION=9
INACTIVE_TTL_MS=5000
# 1000-3000
ROUTE_INTERVAL_MS=2000
ALERT_TTL_MS=20000
BPR_ALPHA=0.15
BPR_BETA=4
# Vehicles per km per lane; matches the Location edge-density snapshot.
ROAD_CAPACITY=180
BLOCKED_MULTIPLIER=10

# ---- Streams / keys (must match other services) ---------------------------
# Location-Worker output
STATE_STREAM=stream:vehicle:state
# Control API Server outbox (EVACS-API-Server EVACS_EMERGENCY_STREAM)
EMERGENCY_STREAM=evacs:stream:emergency-event
# Control API Server cone key; exactly one %s (emergency ID).
EVACS_CONE_KEY_PATTERN=evacs:emergency:%s:cone
# Consumed by Alert-Worker
ALERT_STREAM=stream:alert:event
# WebSocket Gateway copy of ROUTE_UPDATE_REQUESTED
ROUTE_UPDATE_STREAM=stream:evacs_route:update
ALERT_OUTBOX_STREAM=stream:emergency-worker:alert-outbox
DLQ_STREAM=stream:emergency-worker:dlq
VEHICLE_CONSUMER_GROUP=emergency-worker:vehicle-state
EMERGENCY_CONSUMER_GROUP=emergency-worker:emergency

# ---- Consumer tuning (defaults shown) -------------------------------------
READ_COUNT=100
BLOCK_MS=1000
PENDING_MIN_IDLE_MS=10000
MAX_DELIVERIES=5
DLQ_MAXLEN=10000
ALERT_STREAM_MAXLEN=100000
SHUTDOWN_DRAIN_TIMEOUT_MS=10000
